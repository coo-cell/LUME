# Supabase ------------------------------------------------------------
# Get these from https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude ----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Lemon Squeezy (token-based subscription) ----------------------------
# https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Variant IDs (from LS product → variants) — webhook uses these to know
# what to credit when a payment arrives.
LEMONSQUEEZY_VARIANT_CORE=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_PACK_5K=
LEMONSQUEEZY_VARIANT_PACK_15K=
LEMONSQUEEZY_VARIANT_PACK_50K=

# Hosted checkout URLs (from LS product page) — used as Buy buttons on /pricing.
LEMONSQUEEZY_CHECKOUT_CORE_URL=
LEMONSQUEEZY_CHECKOUT_PRO_URL=
LEMONSQUEEZY_CHECKOUT_PACK_5K_URL=
LEMONSQUEEZY_CHECKOUT_PACK_15K_URL=
LEMONSQUEEZY_CHECKOUT_PACK_50K_URL=

# App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
